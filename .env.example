# --- Database -----------------------------------------------------------
# Local dev/build default is SQLite (no external DB required). For
# production, change prisma/schema.prisma's datasource provider to
# "postgresql" and point this at a real Postgres instance.
DATABASE_URL="file:./dev.db"

# --- NextAuth -------------------------------------------------------------
# Generate a strong secret: `openssl rand -base64 32`
NEXTAUTH_SECRET="replace-with-a-strong-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Face generation (pluggable) ------------------------------------------
# Point this at your own image-generation API — Stability AI, Replicate,
# OpenAI Images, etc. If unset (or the call fails), the app falls back to
# the static placeholder at /public/face-placeholder.svg.
FACE_GEN_API_URL=""
FACE_GEN_API_KEY=""

# --- Basecamp OAuth (inert until filled in) -------------------------------
BASECAMP_CLIENT_ID=""
BASECAMP_CLIENT_SECRET=""

# --- Slack OAuth (inert until filled in) ----------------------------------
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
SLACK_SIGNING_SECRET=""
